import 'package:flutter/material.dart';

void main() => runApp(const MaterialApp(debugShowCheckedModeBanner: false, home: MaaDresses()));

class MaaDresses extends StatefulWidget {
  const MaaDresses({super.key});
  @override
  State<MaaDresses> createState() => _MaaDressesState();
}

class _MaaDressesState extends State<MaaDresses> {
  String display = "0";
  List<Map<String, dynamic>> billItems = [];
  double total = 0;

  void add() {
    double val = double.tryParse(display) ?? 0;
    if (val > 0) {
      setState(() {
        billItems.add({'name': 'Dress ${billItems.length + 1}', 'price': val});
        total += val;
        display = "0";
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text("MAA DRESSES DHULAURI"), backgroundColor: Colors.indigo),
      body: Column(
        children: [
          Expanded(
            child: ListView.builder(
              itemCount: billItems.length,
              itemBuilder: (c, i) => ListTile(
                leading: const Icon(Icons.shopping_bag),
                title: Text(billItems[i]['name']),
                trailing: Text("${billItems[i]['price']} TK"),
              ),
            ),
          ),
          Container(
            padding: const EdgeInsets.all(20),
            color: Colors.indigo[50],
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text("TOTAL: $total TK", style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold)),
                Text("Input: $display", style: const TextStyle(fontSize: 18)),
              ],
            ),
          ),
          GridView.count(
            shrinkWrap: true,
            crossAxisCount: 4,
            childAspectRatio: 1.3,
            children: ["7","8","9","C","4","5","6","Del","1","2","3","Add","0",".","00","Print"].map((e) {
              return TextButton(
                onPressed: () {
                  setState(() {
                    if (e == "C") { display = "0"; billItems.clear(); total = 0; }
                    else if (e == "Add") add();
                    else if (e == "Del") display = display.length > 1 ? display.substring(0, display.length - 1) : "0";
                    else display = display == "0" ? e : display + e;
                  });
                },
                child: Text(e, style: const TextStyle(fontSize: 20, color: Colors.black)),
              );
            }).toList(),
          )
        ],
      ),
    );
  }
}
